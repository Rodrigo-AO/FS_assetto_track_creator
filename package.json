{
  "name": "assetto-track-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor de circuitos sobre mapa satélite que exporta pistas jugables para Assetto Corsa.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "earcut": "^2.2.4",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
